{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NAVIO: Verify",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/pio",
      "args": ["run", "-d", "${workspaceFolder}", "-e", "jc3636k518"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "NAVIO: Upload",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/pio",
      "args": ["run", "-d", "${workspaceFolder}", "-e", "jc3636k518", "-t", "upload"],
      "problemMatcher": ["$gcc"],
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "NAVIO: Upload + Serial Monitor",
      "dependsOrder": "sequence",
      "dependsOn": ["NAVIO: Upload", "NAVIO: Serial Monitor"],
      "problemMatcher": []
    },
    {
      "label": "NAVIO: Serial Monitor",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/python",
      "args": ["${workspaceFolder}/firmware/tools/navo_monitor.py", "view"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "NAVIO: Stop Serial Monitor",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/python",
      "args": ["${workspaceFolder}/firmware/tools/navo_monitor.py", "stop"],
      "problemMatcher": []
    },
    {
      "label": "NAVIO: Status",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/python",
      "args": ["${workspaceFolder}/firmware/tools/navo_monitor.py", "status"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ]
}
