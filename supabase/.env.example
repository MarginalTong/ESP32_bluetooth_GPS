# Set in Supabase Edge Function Secrets, never in Flutter or source control.
APPLE_CLIENT_ID=com.williamli.motonav
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY=YOUR_PKCS8_PRIVATE_KEY
# Generate a 32-byte key locally. Keep a secure backup: losing it prevents
# provider token decryption/revocation. Do not rotate it without a migration.
APPLE_TOKEN_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY
